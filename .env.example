# fixture = web serves fixtures/*.json ; live = web proxies to the Hono API
DATA_MODE=fixture
API_URL=http://localhost:8787

# Admin token for POST /challenger: generate with `openssl rand -hex 16` (the API refuses tokens under 16 chars)
ADMIN_TOKEN=
# Live data directory, relative to apps/api
DATA_DIR=../../data
# OpenAI key: copy, persona panel, pack facts (vision), ad visuals (never commit)
OPENAI_API_KEY=
