{
  "name": "hack-dashboard",
  "private": true,
  "packageManager": "pnpm@9.12.0",
  "scripts": {
    "dev": "concurrently -k -n api,web -c cyan,magenta \"pnpm --filter api dev\" \"pnpm --filter web dev\"",
    "check": "tsx fixtures/validate.ts && pnpm -r typecheck",
    "fixtures:validate": "tsx fixtures/validate.ts",
    "test": "pnpm --filter api test"
  },
  "devDependencies": {
    "concurrently": "^9.1.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "@types/node": "^22.10.2"
  },
  "dependencies": {
    "@hack/contract": "workspace:*"
  }
}
